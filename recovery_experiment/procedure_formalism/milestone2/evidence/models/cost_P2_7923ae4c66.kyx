ArchiveEntry "cost_P2_7923ae4c66_rate_integral"
ProgramVariables
  Real d; Real dInit; Real dRate; Real l; Real lInit; Real lRate; Real lower; Real r; Real rInit; Real rRate; Real span; Real tau; Real upper; Real v; Real vInit; Real vRate;
End.
Problem
  (tau=0 & span>=0 & v=vInit & d=dInit & r=rInit & l=lInit) -> [{v'=vRate,d'=dRate,r'=rRate,l'=lRate,tau'=1 & tau<=span}] (v=vInit+vRate*tau & d=dInit+dRate*tau & r=rInit+rRate*tau & l=lInit+lRate*tau & ((lower<=vInit & vInit<=upper & lower<=vInit+span*vRate & vInit+span*vRate<=upper) -> (lower<=v & v<=upper)))
End.
Tactic "Bounded proof"
  implyR(1); solve(1); QE
End.
End.

ArchiveEntry "cost_P2_7923ae4c66_controller"
ProgramVariables
  Real accepted; Real capacity; Real deadline; Real demand; Real horizon; Real initialVolume; Real inlet; Real lower; Real manual; Real minimum; Real output; Real request; Real start; Real upper; Real wIntervention; Real wResource; Real wService; Real wTime; Real watts;
End.
Problem
  (initialVolume=12 & inlet=1 & demand=3 & minimum=2 & horizon=4 & deadline=2 & lower=4 & upper=17 & start=1 & capacity=2 & manual=0 & watts=4 & wService>=0 & wTime>=0 & wIntervention>=0 & wResource>=0) -> [request:=*; accepted:=*; output:=*;
    ? ((request=1)
      & (accepted=request)
      & (output=accepted));] (output=1)
End.
Tactic "Bounded proof"
  implyR(1); chase(1); QE
End.
End.

ArchiveEntry "cost_P2_7923ae4c66_plant"
ProgramVariables
  Real accepted; Real active; Real actuated; Real atEnd; Real atStart; Real capacity; Real deadline; Real demand; Real drive; Real elapsed; Real feed; Real horizon; Real initialVolume; Real inlet; Real lower; Real manual; Real minimum; Real output; Real passage; Real physical; Real power; Real q; Real request; Real safe; Real start; Real upper; Real wIntervention; Real wResource; Real wService; Real wTime; Real watts;
End.
Problem
  (initialVolume=12 & inlet=1 & demand=3 & minimum=2 & horizon=4 & deadline=2 & lower=4 & upper=17 & start=1 & capacity=2 & manual=0 & watts=4 & wService>=0 & wTime>=0 & wIntervention>=0 & wResource>=0) -> [request:=*; accepted:=*; output:=*; feed:=*; power:=*; actuated:=*; drive:=*; passage:=*; q:=*; active:=*; elapsed:=*; atStart:=*; atEnd:=*; safe:=*; physical:=*;
    ? ((request=1)
      & (accepted=request)
      & (output=accepted)
      & (feed=1)
      & (power=feed)
      & (actuated=output)
      & (drive=(actuated*power))
      & (passage=1)
      & (q=((drive*passage)*capacity))
      & (active=(horizon-start))
      & (elapsed=(start+active))
      & (atStart=(initialVolume+(inlet*start)))
      & (atEnd=(atStart+((inlet-q)*active)))
      & ((((lower<=initialVolume) & (initialVolume<=upper) & (lower<=atStart) & (atStart<=upper) & (lower<=atEnd) & (atEnd<=upper)) & safe=1) | (!((lower<=initialVolume) & (initialVolume<=upper) & (lower<=atStart) & (atStart<=upper) & (lower<=atEnd) & (atEnd<=upper)) & safe=0))
      & ((((start<=deadline) & (q>=minimum) & (elapsed=horizon)) & physical=1) | (!((start<=deadline) & (q>=minimum) & (elapsed=horizon)) & physical=0)));] (safe=1 & physical=1)
End.
Tactic "Bounded proof"
  implyR(1); chase(1); QE
End.
End.

ArchiveEntry "cost_P2_7923ae4c66_composition"
ProgramVariables
  Real J; Real accepted; Real active; Real actuated; Real atEnd; Real atStart; Real cIntervention; Real cResource; Real cService; Real cTime; Real capacity; Real credible; Real deadline; Real deficitAtStart; Real demand; Real drive; Real elapsed; Real feed; Real fresh; Real horizon; Real initialVolume; Real inlet; Real lower; Real manual; Real minimum; Real output; Real passage; Real physical; Real power; Real q; Real reading; Real request; Real safe; Real start; Real trusted; Real upper; Real wIntervention; Real wResource; Real wService; Real wTime; Real watts;
End.
Problem
  (initialVolume=12 & inlet=1 & demand=3 & minimum=2 & horizon=4 & deadline=2 & lower=4 & upper=17 & start=1 & capacity=2 & manual=0 & watts=4 & wService>=0 & wTime>=0 & wIntervention>=0 & wResource>=0) -> [request:=*; accepted:=*; output:=*; feed:=*; power:=*; actuated:=*; drive:=*; passage:=*; q:=*; active:=*; elapsed:=*; atStart:=*; atEnd:=*; safe:=*; physical:=*; trusted:=*; fresh:=*; reading:=*; credible:=*; deficitAtStart:=*; cService:=*; cTime:=*; cIntervention:=*; cResource:=*; J:=*;
    ? ((request=1)
      & (accepted=request)
      & (output=accepted)
      & (feed=1)
      & (power=feed)
      & (actuated=output)
      & (drive=(actuated*power))
      & (passage=1)
      & (q=((drive*passage)*capacity))
      & (active=(horizon-start))
      & (elapsed=(start+active))
      & (atStart=(initialVolume+(inlet*start)))
      & (atEnd=(atStart+((inlet-q)*active)))
      & ((((lower<=initialVolume) & (initialVolume<=upper) & (lower<=atStart) & (atStart<=upper) & (lower<=atEnd) & (atEnd<=upper)) & safe=1) | (!((lower<=initialVolume) & (initialVolume<=upper) & (lower<=atStart) & (atStart<=upper) & (lower<=atEnd) & (atEnd<=upper)) & safe=0))
      & ((((start<=deadline) & (q>=minimum) & (elapsed=horizon)) & physical=1) | (!((start<=deadline) & (q>=minimum) & (elapsed=horizon)) & physical=0))
      & (trusted=1)
      & (fresh=1)
      & (((trusted=1) & reading=q) | ((trusted=0) & reading=0) | ((trusted=0) & reading=demand))
      & ((((trusted=1) & (fresh=1) & (reading=q) & (reading>=minimum)) & credible=1) | (!((trusted=1) & (fresh=1) & (reading=q) & (reading>=minimum)) & credible=0))
      & (deficitAtStart=(start*demand))
      & (cService=(deficitAtStart+(active*(demand-q))))
      & (((q>=minimum) & cTime=start) | (!(q>=minimum) & cTime=horizon))
      & (cIntervention=(manual*accepted))
      & (cResource=((drive*watts)*active))
      & (J=((((wService*cService)+(wTime*cTime))+(wIntervention*cIntervention))+(wResource*cResource))));] (((safe=1) & (physical=1) & (credible=1) & (elapsed=horizon) & (cService=6) & (cTime=1) & (cIntervention=0) & (cResource=12) & (J=((((wService*6)+(wTime*1))+(wIntervention*0))+(wResource*12)))))
End.
Tactic "Bounded proof"
  implyR(1); chase(1); QE
End.
End.

