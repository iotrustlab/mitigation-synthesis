/* Recovery experiment water_game. Base c817476a8f1e92a7d801652e583d4e8d0a23096a. */
ArchiveEntry "water_game_adaptive_win"
ProgramVariables
  Real active; Real atEnd; Real atStart; Real elapsed; Real feed; Real fresh; Real initialVolume; Real q; Real reading; Real seeB; Real seeC; Real start; Real trusted; Real upB; Real upC;
End.
Problem
  initialVolume=12 -> <{{upB:=1; upC:=1; feed:=1;} ++ {upB:=0; upC:=1; feed:=1;} ++ {upB:=1; upC:=0; feed:=1;}}^@; seeB:=upB*feed; seeC:=upC*feed; {{?seeB=1; start:=1; q:=3*upB*feed;} ++ {?seeC=1; start:=2; q:=3*upC*feed;} ++ {start:=0; q:=0;}}; active:=4-start; atStart:=initialVolume+1*start; atEnd:=atStart+(1-q)*active; elapsed:=start+active; reading:=q; fresh:=1; trusted:=1;>(4<=initialVolume & initialVolume<=17 & 4<=atStart & atStart<=17 & 4<=atEnd & atEnd<=17 & start<=2 & q>=2 & elapsed=4 & reading=q & fresh=1 & trusted=1 & reading>=2)
End.
Tactic "Bounded proof"
  implyR(1); chase(1); QE
End.
End.

ArchiveEntry "water_game_shared_power_no_win"
ProgramVariables
  Real active; Real atEnd; Real atStart; Real elapsed; Real feed; Real fresh; Real initialVolume; Real q; Real reading; Real seeB; Real seeC; Real start; Real trusted; Real upB; Real upC;
End.
Problem
  initialVolume=12 -> !(<{{upB:=1; upC:=1; feed:=1;} ++ {upB:=0; upC:=1; feed:=1;} ++ {upB:=1; upC:=0; feed:=1;} ++ {upB:=1; upC:=1; feed:=0;}}^@; seeB:=upB*feed; seeC:=upC*feed; {{?seeB=1; start:=1; q:=3*upB*feed;} ++ {?seeC=1; start:=2; q:=3*upC*feed;} ++ {start:=0; q:=0;}}; active:=4-start; atStart:=initialVolume+1*start; atEnd:=atStart+(1-q)*active; elapsed:=start+active; reading:=q; fresh:=1; trusted:=1;>(4<=initialVolume & initialVolume<=17 & 4<=atStart & atStart<=17 & 4<=atEnd & atEnd<=17 & start<=2 & q>=2 & elapsed=4 & reading=q & fresh=1 & trusted=1 & reading>=2))
End.
Tactic "Bounded proof"
  implyR(1); chase(1); QE
End.
End.

