# Source this file from its repository location, or copy it and replace the
# storage defaults with absolute paths. Do not put tokens or secrets here.

_qwen_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_qwen_repo_root="$(cd "${_qwen_env_dir}/../.." && pwd)"

# Portable defaults are the repository's sibling drics-llm directory. On CHPC,
# an explicit group-storage path is clearer for long-lived allocations.
export DRICS_MODEL_DIR="${DRICS_MODEL_DIR:-${_qwen_repo_root}/../drics-llm/models}"
export HF_HOME="${HF_HOME:-${_qwen_repo_root}/../drics-llm/cache}"
export DRICS_HF_HUB_CACHE="${DRICS_HF_HUB_CACHE:-${HF_HOME}/hub}"
# CHPC example overrides:
# export DRICS_MODEL_DIR="/uufs/chpc.utah.edu/common/home/garcia-group1/drics-llm/models"
# export HF_HOME="/uufs/chpc.utah.edu/common/home/garcia-group1/drics-llm/cache"

# Immutable artifact identity used by the baseline downloader and launcher:
export DRICS_LLM_MODEL="Qwen/Qwen3.5-9B"
export DRICS_LLM_REVISION="c202236235762e1c871ad0ccb60c8ee5ba337b9a"
# Optional alternate location for another verified copy of this pinned snapshot:
# export DRICS_LLM_MODEL_PATH="/absolute/path/to/the/pinned/model-snapshot"
export DRICS_LLM_MODEL_PATH="${DRICS_LLM_MODEL_PATH:-${DRICS_MODEL_DIR}/Qwen--Qwen3.5-9B/${DRICS_LLM_REVISION}}"
export DRICS_LLM_MODEL_MANIFEST="${DRICS_LLM_MODEL_PATH}/DRICS_MODEL_MANIFEST.json"

# The server binds only to loopback; connect from another machine with SSH
# port forwarding rather than exposing this port to the cluster network.
export DRICS_LLM_HOST="127.0.0.1"
export DRICS_LLM_PORT="8000"
export DRICS_LLM_BASE_URL="http://127.0.0.1:8000/v1"

# Conservative initial Dr.ICS settings for a single >=24 GB GPU.
export DRICS_LLM_TENSOR_PARALLEL_SIZE="1"
export DRICS_LLM_MAX_MODEL_LEN="16384"
export DRICS_LLM_GPU_MEMORY_UTILIZATION="0.90"
export DRICS_LLM_MIN_GPU_MEMORY_MIB="22000"
export DRICS_LLM_ENGINE_SEED="20260926"

# If the evaluator runs on an SSH-tunnel client rather than inside the GPU job,
# copy these values from the job's nvidia-smi output so its artifact describes
# inference hardware instead of the client machine.
# export DRICS_LLM_GPU_MODEL="<ALLOCATED_GPU_MODEL>"
# export DRICS_LLM_GPU_COUNT="1"

# Evaluation-side decoding defaults. The evaluator records these in its output.
export DRICS_LLM_TEMPERATURE="0"
export DRICS_LLM_TOP_P="1"
export DRICS_LLM_MAX_OUTPUT_TOKENS="4096"
export DRICS_LLM_SEED="20260926"
export DRICS_LLM_DISABLE_THINKING="true"

unset _qwen_env_dir _qwen_repo_root
